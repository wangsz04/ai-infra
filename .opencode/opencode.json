{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools-mcp": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"],
      "enabled": false
    },
    "figma-developer-mcp": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--figma-api-key={env:FIGMA_KEY}", "--stdio"],
      "enabled": false
    },
    "d2c-sloth-mcp": {
      "type": "local",
      "command": ["sloth", "--stdio"],
      "enabled": false
    }
  },
  "agent": {}
}
